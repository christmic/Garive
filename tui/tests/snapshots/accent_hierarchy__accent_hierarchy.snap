---
source: tui/tests/accent_hierarchy.rs
expression: "evidence.join(\"\\n\\n\")"
---
Dark
  suggestions plain=fg=Reset bg=Rgb(31, 31, 31) modifier=NONE selected=fg=Cyan bg=Rgb(40, 55, 68) modifier=BOLD
  palette     plain=fg=Reset bg=Rgb(31, 31, 31) modifier=DIM selected=fg=Cyan bg=Rgb(40, 55, 68) modifier=BOLD
  navigator   plain=fg=Reset bg=Rgb(31, 31, 31) modifier=DIM selected=fg=Reset bg=Rgb(40, 55, 68) modifier=BOLD

Light
  suggestions plain=fg=Reset bg=Rgb(245, 245, 245) modifier=NONE selected=fg=Rgb(0, 95, 135) bg=Rgb(214, 229, 255) modifier=BOLD
  palette     plain=fg=Reset bg=Rgb(245, 245, 245) modifier=DIM selected=fg=Rgb(0, 95, 135) bg=Rgb(214, 229, 255) modifier=BOLD
  navigator   plain=fg=Reset bg=Rgb(245, 245, 245) modifier=DIM selected=fg=Reset bg=Rgb(214, 229, 255) modifier=BOLD

Mono
  suggestions plain=fg=Reset bg=Reset modifier=NONE selected=fg=Reset bg=Reset modifier=BOLD | REVERSED
  palette     plain=fg=Reset bg=Reset modifier=DIM selected=fg=Reset bg=Reset modifier=BOLD | REVERSED
  navigator   plain=fg=Reset bg=Reset modifier=DIM selected=fg=Reset bg=Reset modifier=BOLD | REVERSED
