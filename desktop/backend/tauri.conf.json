{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Garive",
  "mainBinaryName": "garive-desktop",
  "version": "0.1.0",
  "identifier": "com.garive.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --dir frontend build",
    "beforeDevCommand": "pnpm --dir frontend dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Garive",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 16, "y": 16 },
        "acceptFirstMouse": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["menu"],
          "state": "followsWindowActiveState"
        },
        "tabbingIdentifier": "com.garive.desktop.main"
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main-setup"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "A local-first agent for durable work.",
    "longDescription": "Garive turns outcomes into inspectable work with a local embedded Runtime, durable Sessions, and explicit capability boundaries.",
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
