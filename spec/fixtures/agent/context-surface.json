{
  "schema_version": 1,
  "contract": "context-surface",
  "cases": [
    {
      "name": "filter-purpose-and-redact",
      "request": {"purpose": "inference", "after": 1, "through": 4, "max_items": 10, "max_bytes": 100},
      "candidates": [
        {"position": 1, "retention": "optional", "visibility": "visible", "items": ["old"]},
        {"position": 2, "retention": "optional", "visibility": "purpose:governance", "items": ["hidden"]},
        {"position": 3, "retention": "required", "visibility": "redacted", "items": ["secret"]},
        {"position": 4, "retention": "optional", "visibility": "visible", "items": ["hi"]}
      ],
      "expected": {"status": "ok", "retained": [3, 4], "dropped": [], "filtered": [1, 2], "items": ["redacted", "text:hi"], "item_count": 2, "bytes": 2}
    },
    {
      "name": "required-exceeds-byte-budget",
      "request": {"purpose": "inference", "after": null, "through": 1, "max_items": 2, "max_bytes": 3},
      "candidates": [{"position": 1, "retention": "required", "visibility": "visible", "items": ["abcd"]}],
      "expected": {"status": "required-facts-exceed-budget"}
    },
    {
      "name": "newest-first-retention-chronological-output",
      "request": {"purpose": "inference", "after": null, "through": 3, "max_items": 3, "max_bytes": 5},
      "candidates": [
        {"position": 1, "retention": "optional", "visibility": "visible", "items": ["abc"]},
        {"position": 2, "retention": "optional", "visibility": "visible", "items": ["abcde"]},
        {"position": 3, "retention": "optional", "visibility": "visible", "items": ["xy"]}
      ],
      "expected": {"status": "ok", "retained": [1, 3], "dropped": [2], "filtered": [], "items": ["text:abc", "text:xy"], "item_count": 2, "bytes": 5}
    },
    {
      "name": "candidate-is-atomic",
      "request": {"purpose": "inference", "after": null, "through": 2, "max_items": 1, "max_bytes": 10},
      "candidates": [
        {"position": 1, "retention": "optional", "visibility": "visible", "items": ["a"]},
        {"position": 2, "retention": "optional", "visibility": "visible", "items": ["b", "c"]}
      ],
      "expected": {"status": "ok", "retained": [1], "dropped": [2], "filtered": [], "items": ["text:a"], "item_count": 1, "bytes": 1}
    },
    {
      "name": "larger-budget-admits-newer-priority",
      "request": {"purpose": "inference", "after": null, "through": 3, "max_items": 3, "max_bytes": 7},
      "candidates": [
        {"position": 1, "retention": "optional", "visibility": "visible", "items": ["abc"]},
        {"position": 2, "retention": "optional", "visibility": "visible", "items": ["abcde"]},
        {"position": 3, "retention": "optional", "visibility": "visible", "items": ["xy"]}
      ],
      "expected": {"status": "ok", "retained": [2, 3], "dropped": [1], "filtered": [], "items": ["text:abcde", "text:xy"], "item_count": 2, "bytes": 7}
    },
    {
      "name": "utf8-budget-counts-bytes",
      "request": {"purpose": "inference", "after": null, "through": 1, "max_items": 1, "max_bytes": 6},
      "candidates": [{"position": 1, "retention": "required", "visibility": "visible", "items": ["蟹蟹"]}],
      "expected": {"status": "ok", "retained": [1], "dropped": [], "filtered": [], "items": ["text:蟹蟹"], "item_count": 1, "bytes": 6}
    },
    {
      "name": "decreasing-position-fails",
      "request": {"purpose": "inference", "after": null, "through": 2, "max_items": 2, "max_bytes": 10},
      "candidates": [
        {"position": 2, "retention": "optional", "visibility": "visible", "items": ["b"]},
        {"position": 1, "retention": "optional", "visibility": "visible", "items": ["a"]}
      ],
      "expected": {"status": "non-increasing-position"}
    },
    {
      "name": "duplicate-reference-fails",
      "request": {"purpose": "inference", "after": null, "through": 1, "max_items": 2, "max_bytes": 10},
      "candidates": [
        {"position": 1, "retention": "optional", "visibility": "visible", "items": ["a"]},
        {"position": 1, "retention": "optional", "visibility": "visible", "items": ["b"]}
      ],
      "expected": {"status": "duplicate-reference"}
    },
    {
      "name": "empty-eligible-surface",
      "request": {"purpose": "tool-preparation", "after": null, "through": 1, "max_items": 2, "max_bytes": 10},
      "candidates": [{"position": 1, "retention": "optional", "visibility": "purpose:governance", "items": ["hidden"]}],
      "expected": {"status": "ok", "retained": [], "dropped": [], "filtered": [1], "items": [], "item_count": 0, "bytes": 0}
    }
  ]
}
