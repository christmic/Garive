{
  "schema_version": 1,
  "contract": "prepared-tool-call",
  "definitions": [
    {
      "name": "read_file",
      "revision": "1",
      "description": "Read one admitted file.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1}
        },
        "required": ["path"],
        "additionalProperties": false
      },
      "requirements": {
        "capabilities": ["filesystem_read"],
        "max_duration_ms": 5000,
        "max_output_bytes": 4096
      },
      "replay_class": "read_only"
    },
    {
      "name": "complex",
      "revision": "3",
      "description": "Exercise the complete portable schema composition surface.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "mode": {"type": "string", "enum": ["fast", "safe"]},
          "enabled": {"const": true},
          "items": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 5},
            "minItems": 1,
            "maxItems": 2
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 10,
            "multipleOf": 0.5
          },
          "choice": {"oneOf": [{"type": "integer"}, {"type": "string"}]},
          "alt": {"anyOf": [{"type": "boolean"}, {"type": "null"}]},
          "blocked": {"not": {"const": "no"}},
          "bounded": {
            "allOf": [
              {"type": "string", "minLength": 1},
              {"type": "string", "maxLength": 3}
            ]
          }
        },
        "required": ["mode", "enabled", "items", "score", "choice", "alt", "blocked", "bounded"],
        "additionalProperties": false
      },
      "requirements": {
        "capabilities": ["filesystem_read", "network"],
        "max_duration_ms": 10000,
        "max_output_bytes": 8192
      },
      "replay_class": "idempotent"
    }
  ],
  "invalid_definitions": [
    {
      "name": "root-policy-required",
      "schema": {"type": "object", "properties": {}},
      "expected_code": "invalid_tool_definition"
    },
    {
      "name": "unsupported-pattern",
      "schema": {
        "type": "object",
        "properties": {"value": {"type": "string", "pattern": "x"}},
        "additionalProperties": false
      },
      "expected_code": "unsupported_schema_keyword"
    },
    {
      "name": "unsupported-ref",
      "schema": {
        "type": "object",
        "properties": {"value": {"$ref": "#/$defs/value"}},
        "additionalProperties": false
      },
      "expected_code": "unsupported_schema_keyword"
    }
  ],
  "cases": [
    {
      "name": "canonical-object-order",
      "input": {"model_call_id": "call-a", "tool_name": "read_file", "arguments_json": "{\"path\":\"src/main.rs\",\"line\":7}"},
      "expected": {
        "status": "prepared",
        "normalized_arguments": "{\"line\":7,\"path\":\"src/main.rs\"}",
        "input_digest": "01c07a4a44b08a53862a77c96eb453b5b46405a098d2b0a60f8a7d8c0c75dc4c"
      }
    },
    {
      "name": "same-meaning-same-digest",
      "input": {"model_call_id": "call-b", "tool_name": "read_file", "arguments_json": "{ \"line\": 7, \"path\": \"src/main.rs\" }"},
      "expected": {
        "status": "prepared",
        "normalized_arguments": "{\"line\":7,\"path\":\"src/main.rs\"}",
        "input_digest": "01c07a4a44b08a53862a77c96eb453b5b46405a098d2b0a60f8a7d8c0c75dc4c"
      }
    },
    {
      "name": "complete-schema-surface",
      "input": {"model_call_id": "call-c", "tool_name": "complex", "arguments_json": "{\"score\":2.5,\"items\":[\"蟹\",\"ok\"],\"choice\":\"x\",\"alt\":false,\"blocked\":\"yes\",\"bounded\":\"ok\",\"enabled\":true,\"mode\":\"safe\"}"},
      "expected": {
        "status": "prepared",
        "normalized_arguments": "{\"alt\":false,\"blocked\":\"yes\",\"bounded\":\"ok\",\"choice\":\"x\",\"enabled\":true,\"items\":[\"蟹\",\"ok\"],\"mode\":\"safe\",\"score\":2.5}",
        "input_digest": "c4643cef90a205c8c48af11bf7edeeecefe73234959702225adc8965969cd160"
      }
    },
    {"name": "unknown-tool", "input": {"model_call_id": "call", "tool_name": "missing", "arguments_json": "{}"}, "expected": {"status": "error", "code": "tool_not_admitted"}},
    {"name": "empty-call-id", "input": {"model_call_id": "", "tool_name": "read_file", "arguments_json": "{}"}, "expected": {"status": "error", "code": "invalid_model_call_id"}},
    {"name": "empty-tool-name", "input": {"model_call_id": "call", "tool_name": "", "arguments_json": "{}"}, "expected": {"status": "error", "code": "invalid_tool_name"}},
    {"name": "malformed-json", "input": {"model_call_id": "call", "tool_name": "read_file", "arguments_json": "{"}, "expected": {"status": "error", "code": "invalid_arguments_json"}},
    {"name": "duplicate-json-key", "input": {"model_call_id": "call", "tool_name": "read_file", "arguments_json": "{\"path\":\"a\",\"path\":\"b\"}"}, "expected": {"status": "error", "code": "invalid_arguments_json"}},
    {"name": "missing-required", "input": {"model_call_id": "call", "tool_name": "read_file", "arguments_json": "{}"}, "expected": {"status": "error", "code": "arguments_schema_mismatch", "instance_path": "", "schema_path": "/required", "keyword": "required"}},
    {"name": "wrong-type", "input": {"model_call_id": "call", "tool_name": "read_file", "arguments_json": "{\"path\":\"a\",\"line\":true}"}, "expected": {"status": "error", "code": "arguments_schema_mismatch", "instance_path": "/line", "schema_path": "/properties/line/type", "keyword": "type"}},
    {"name": "additional-property", "input": {"model_call_id": "call", "tool_name": "read_file", "arguments_json": "{\"path\":\"a\",\"extra\":1}"}, "expected": {"status": "error", "code": "arguments_schema_mismatch", "instance_path": "/extra", "schema_path": "/additionalProperties", "keyword": "additionalProperties"}},
    {"name": "string-too-short", "input": {"model_call_id": "call", "tool_name": "read_file", "arguments_json": "{\"path\":\"\"}"}, "expected": {"status": "error", "code": "arguments_schema_mismatch", "instance_path": "/path", "schema_path": "/properties/path/minLength", "keyword": "minLength"}},
    {"name": "enum-mismatch", "input": {"model_call_id": "call", "tool_name": "complex", "arguments_json": "{\"mode\":\"other\",\"enabled\":true,\"items\":[\"x\"],\"score\":1,\"choice\":1,\"alt\":null,\"blocked\":\"yes\",\"bounded\":\"ok\"}"}, "expected": {"status": "error", "code": "arguments_schema_mismatch", "instance_path": "/mode", "schema_path": "/properties/mode/enum", "keyword": "enum"}},
    {"name": "not-mismatch", "input": {"model_call_id": "call", "tool_name": "complex", "arguments_json": "{\"mode\":\"safe\",\"enabled\":true,\"items\":[\"x\"],\"score\":1,\"choice\":1,\"alt\":null,\"blocked\":\"no\",\"bounded\":\"ok\"}"}, "expected": {"status": "error", "code": "arguments_schema_mismatch", "instance_path": "/blocked", "schema_path": "/properties/blocked/not", "keyword": "not"}},
    {"name": "const-mismatch", "input": {"model_call_id": "call", "tool_name": "complex", "arguments_json": "{\"mode\":\"safe\",\"enabled\":false,\"items\":[\"x\"],\"score\":1,\"choice\":1,\"alt\":null,\"blocked\":\"yes\",\"bounded\":\"ok\"}"}, "expected": {"status": "error", "code": "arguments_schema_mismatch", "instance_path": "/enabled", "schema_path": "/properties/enabled/const", "keyword": "const"}},
    {"name": "min-items", "input": {"model_call_id": "call", "tool_name": "complex", "arguments_json": "{\"mode\":\"safe\",\"enabled\":true,\"items\":[],\"score\":1,\"choice\":1,\"alt\":null,\"blocked\":\"yes\",\"bounded\":\"ok\"}"}, "expected": {"status": "error", "code": "arguments_schema_mismatch", "instance_path": "/items", "schema_path": "/properties/items/minItems", "keyword": "minItems"}},
    {"name": "max-items", "input": {"model_call_id": "call", "tool_name": "complex", "arguments_json": "{\"mode\":\"safe\",\"enabled\":true,\"items\":[\"a\",\"b\",\"c\"],\"score\":1,\"choice\":1,\"alt\":null,\"blocked\":\"yes\",\"bounded\":\"ok\"}"}, "expected": {"status": "error", "code": "arguments_schema_mismatch", "instance_path": "/items", "schema_path": "/properties/items/maxItems", "keyword": "maxItems"}},
    {"name": "nested-max-length", "input": {"model_call_id": "call", "tool_name": "complex", "arguments_json": "{\"mode\":\"safe\",\"enabled\":true,\"items\":[\"toolong\"],\"score\":1,\"choice\":1,\"alt\":null,\"blocked\":\"yes\",\"bounded\":\"ok\"}"}, "expected": {"status": "error", "code": "arguments_schema_mismatch", "instance_path": "/items/0", "schema_path": "/properties/items/items/maxLength", "keyword": "maxLength"}},
    {"name": "minimum", "input": {"model_call_id": "call", "tool_name": "complex", "arguments_json": "{\"mode\":\"safe\",\"enabled\":true,\"items\":[\"x\"],\"score\":-0.5,\"choice\":1,\"alt\":null,\"blocked\":\"yes\",\"bounded\":\"ok\"}"}, "expected": {"status": "error", "code": "arguments_schema_mismatch", "instance_path": "/score", "schema_path": "/properties/score/minimum", "keyword": "minimum"}},
    {"name": "exclusive-maximum", "input": {"model_call_id": "call", "tool_name": "complex", "arguments_json": "{\"mode\":\"safe\",\"enabled\":true,\"items\":[\"x\"],\"score\":10,\"choice\":1,\"alt\":null,\"blocked\":\"yes\",\"bounded\":\"ok\"}"}, "expected": {"status": "error", "code": "arguments_schema_mismatch", "instance_path": "/score", "schema_path": "/properties/score/exclusiveMaximum", "keyword": "exclusiveMaximum"}},
    {"name": "multiple-of", "input": {"model_call_id": "call", "tool_name": "complex", "arguments_json": "{\"mode\":\"safe\",\"enabled\":true,\"items\":[\"x\"],\"score\":1.2,\"choice\":1,\"alt\":null,\"blocked\":\"yes\",\"bounded\":\"ok\"}"}, "expected": {"status": "error", "code": "arguments_schema_mismatch", "instance_path": "/score", "schema_path": "/properties/score/multipleOf", "keyword": "multipleOf"}},
    {"name": "one-of", "input": {"model_call_id": "call", "tool_name": "complex", "arguments_json": "{\"mode\":\"safe\",\"enabled\":true,\"items\":[\"x\"],\"score\":1,\"choice\":true,\"alt\":null,\"blocked\":\"yes\",\"bounded\":\"ok\"}"}, "expected": {"status": "error", "code": "arguments_schema_mismatch", "instance_path": "/choice", "schema_path": "/properties/choice/oneOf", "keyword": "oneOf"}},
    {"name": "any-of", "input": {"model_call_id": "call", "tool_name": "complex", "arguments_json": "{\"mode\":\"safe\",\"enabled\":true,\"items\":[\"x\"],\"score\":1,\"choice\":1,\"alt\":\"x\",\"blocked\":\"yes\",\"bounded\":\"ok\"}"}, "expected": {"status": "error", "code": "arguments_schema_mismatch", "instance_path": "/alt", "schema_path": "/properties/alt/anyOf", "keyword": "anyOf"}},
    {"name": "all-of", "input": {"model_call_id": "call", "tool_name": "complex", "arguments_json": "{\"mode\":\"safe\",\"enabled\":true,\"items\":[\"x\"],\"score\":1,\"choice\":1,\"alt\":null,\"blocked\":\"yes\",\"bounded\":\"long\"}"}, "expected": {"status": "error", "code": "arguments_schema_mismatch", "instance_path": "/bounded", "schema_path": "/properties/bounded/allOf/maxLength", "keyword": "maxLength"}}
  ]
}
